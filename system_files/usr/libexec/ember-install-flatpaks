#!/usr/bin/bash
set -euo pipefail

state_dir=/var/lib/ember-flatpaks
app_list=/usr/share/ember/flatpaks

if [[ -f "$state_dir/installed" ]]; then
    exit 0
fi

mapfile -t apps < "$app_list"
if (( ${#apps[@]} == 0 )); then
    echo "Ember's Flatpak app list is empty." >&2
    exit 1
fi

flatpak remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

echo "Installing Ember's Flatpak apps. Downloads may take a while."
if ! flatpak install --system --noninteractive --assumeyes --or-update flathub "${apps[@]}"; then
    echo "Flatpak setup did not finish. Setup can resume without downloading completed apps again." >&2
    exit 1
fi

mkdir -p "$state_dir"
touch "$state_dir/installed"
echo "Ember's Flatpak apps are installed."
