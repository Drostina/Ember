[Unit]
Description=Install Ember's Flatpak apps
Wants=network-online.target
After=network-online.target bazzite-flatpak-manager.service ublue-nvidia-flatpak-runtime-sync.service
ConditionPathExists=/run/ostree-booted
ConditionPathExists=!/var/lib/ember-flatpaks/installed
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/bash /usr/libexec/ember-install-flatpaks
StateDirectory=ember-flatpaks
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
